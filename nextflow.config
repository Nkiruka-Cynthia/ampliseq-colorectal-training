/*
 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ampliseq-colorectal-training — nextflow.config
    STaiMIC 16S microbiome practical
 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow.enable.dsl = 2

params {
    // Input / output
    input               = "${launchDir}/data/samplesheet.csv"
    outdir              = "${launchDir}/results"

    // 16S region and primers (V4 region for demonstration)
    FW_primer           = "GTGYCAGCMGCCGCGGTAA"
    RV_primer           = "GGACTACNVGGGTWTCTAAT"

    // Taxonomy database: SILVA 138 (default)
    dada_ref_taxonomy   = "silva=138"
    
    // Analysis parameters
    skip_barplot        = false
    skip_asv_plots      = false
    skip_diversity      = false
    min_frequency       = 10
    metadata_category   = "status"  // For comparing healthy vs CRC
}

// Resource ceiling — conservative for Codespaces free tier (2-core/8GB)
process {
    resourceLimits = [
        cpus   : 2,
        memory : 6.GB,
        time   : '30.min'
    ]
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 1
}

profiles {
    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        singularity.enabled  = false
        conda.enabled        = false
    }
    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
    }
}

timeline {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

manifest {
    name            = 'ampliseq-colorectal-training'
    description     = '16S microbiome analysis - STaiMIC practical'
    version         = '1.0.0'
    nextflowVersion = '>=25.10.0'
    defaultBranch   = 'main'
}

wave {
    enabled = false
}
