/*
 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ampliseq-colorectal-training — nextflow.config
    STaiMIC 16S microbiome practical
 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow.enable.dsl = 2

params {
    // Default output location — main.sh always passes --outdir explicitly,
    // this is just a safe fallback if someone runs nextflow directly.
    outdir = "${launchDir}/results"

    // NOTE: input, metadata, FW_primer, RV_primer, dada_ref_taxonomy, and
    // the skip_*/min_frequency/metadata_category params used to live here.
    // They were removed on purpose: setting them as global defaults would
    // silently override -profile test's own built-in test dataset and
    // parameters whenever this config is picked up from the launch
    // directory. For real data, pass them explicitly on the command line
    // (see the reference command printed by main.sh, or README.md).
}

// Resource ceiling — tuned for a live class on modest local hardware
// (4-core laptop / Codespaces free tier). Kept LOW on purpose: if a
// step hangs during class, we want it to fail fast, not silently eat
// the class time. main.sh's live-demo run also passes --skip_qiime2,
// which avoids the slowest step (QIIME2 classifier training) entirely
// — this time limit is a safety net, not something we expect to hit.
process {
    resourceLimits = [
        cpus   : 2,
        memory : 10.GB,
        time   : '40.min'
    ]
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {
    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        singularity.enabled  = false
        conda.enabled        = false
    }
    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
    }
}

timeline {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled  = true
    file     = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

manifest {
    name            = 'ampliseq-colorectal-training'
    description     = '16S microbiome analysis - STaiMIC practical'
    version         = '1.0.0'
    nextflowVersion = '>=25.10.0'
    defaultBranch   = 'main'
}

wave {
    enabled = false
}